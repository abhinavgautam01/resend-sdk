      r: false
      sh: "The region where the domain is hosted."
      t: "`$STRING`"
    }
    status: {
      h: "Status"
      n: "status"
      r: false
      sh: "The status of the domain."
      t: "`$STRING`"
    }
    tls: {
      h: "Tls"
      n: "tls"
      r: false
      sh: "TLS mode."
