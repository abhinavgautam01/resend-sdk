    field: "id"
    name: "id"
  }

  name: "domain"
  op: {
    create: {
      name: "create"
      points: [
        {
          co: {
            id: "POST /domains/{domain_id}/verify"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "id"
                or: "domain_id"
                r: true
