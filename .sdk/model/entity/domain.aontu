              }
            ]
          }
          m: "POST"
          o: "/domains/{domain_id}/verify"
          q: {
            "$action": "verify"
            exist: [
              "id"
            ]
          }
          r: {
            param: {
              domain_id: "id"
            }
          }
          s: [
            {
              lit: "domains"
            }
            {
              var: "id"
            }
            {
              lit: "verify"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
