# Entity: suppression

main: kit: entity: suppression: {

  alias: field: {}

  fields: {
    created_at: {
      h: "Created At"
      n: "created_at"
      r: false
      sh: "Timestamp indicating when the suppression was created."
      t: "`$STRING`"
    }
    email: {
      h: "Email"
      n: "email"
      r: false
      sh: "Email address that is suppressed."
      t: "`$STRING`"
    }
    id: {
      h: "Id"
      n: "id"
      r: false
      sh: "Unique identifier for the suppression."
      t: "`$STRING`"
    }
    object: {
      h: "Object"
      n: "object"
      r: false
      sh: "Type of the response object."
      t: "`$STRING`"
    }
    origin: {
      h: "Origin"
      n: "origin"
      r: false
      sh: "Origin of the suppression."
      t: "`$STRING`"
    }
    source_id: {
      h: "Source Id"
      n: "source_id"
      r: false
      sh: "Identifier of the event that caused the suppression, such as the email that bounced or complained."
      t: "`$STRING`"
    }
  }

  id: {
    field: "id"
    name: "id"
  }

  name: "suppression"
  op: {
    load: {
      name: "load"
      points: [
        {
          co: {
            id: "GET /suppressions/{suppression}"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "id"
                or: "suppression"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          m: "GET"
          o: "/suppressions/{suppression}"
          q: {
            exist: [
              "id"
            ]
          }
          r: {
            param: {
              suppression: "id"
            }
          }
          s: [
            {
              lit: "suppressions"
            }
            {
              var: "id"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
