# Entity: template

main: kit: entity: template: {

  alias: field: {}

  fields: {
    alias: {
      h: "Alias"
      n: "alias"
      r: false
      sh: "The alias of the template."
      t: "`$STRING`"
    }
    created_at: {
      h: "Created At"
      n: "created_at"
      r: false
      sh: "Timestamp indicating when the template was created."
      t: "`$STRING`"
    }
    current_version_id: {
      h: "Current Version Id"
      n: "current_version_id"
      r: false
      sh: "The ID of the current version of the template."
      t: "`$STRING`"
    }
    from: {
      h: "From"
      n: "from"
      r: false
      sh: "Sender email address."
      t: "`$STRING`"
    }
    has_unpublished_versions: {
      h: "Has Unpublished Versions"
      n: "has_unpublished_versions"
      r: false
      sh: "Indicates whether the template has unpublished versions."
      t: "`$BOOLEAN`"
    }
    html: {
      h: "Html"
      n: "html"
      r: false
      sh: "The HTML version of the template."
      t: "`$STRING`"
    }
    id: {
      h: "Id"
      n: "id"
      r: false
      sh: "The ID of the template."
      t: "`$STRING`"
    }
    name: {
      h: "Name"
      n: "name"
      r: false
      sh: "The name of the template."
      t: "`$STRING`"
    }
    object: {
      h: "Object"
      n: "object"
      r: false
      sh: "The type of object."
      t: "`$STRING`"
    }
    published_at: {
      h: "Published At"
      n: "published_at"
      r: false
      sh: "Timestamp indicating when the template was published."
      t: [
        "`$ONE`"
        [
          "`$STRING`"
          "`$NULL`"
        ]
      ]
    }
    reply_to: {
      h: "Reply To"
      n: "reply_to"
      r: false
      sh: "Reply-to email addresses."
      t: [
        "`$ONE`"
        [
          "`$ARRAY`"
          "`$NULL`"
        ]
      ]
    }
    status: {
      h: "Status"
      n: "status"
      r: false
      sh: "The publication status of the template."
      t: "`$STRING`"
    }
    subject: {
      h: "Subject"
      n: "subject"
      r: false
      sh: "Email subject."
      t: "`$STRING`"
    }
    text: {
      h: "Text"
      n: "text"
      r: false
      sh: "The plain text version of the template."
      t: "`$STRING`"
    }
    updated_at: {
      h: "Updated At"
      n: "updated_at"
      r: false
      sh: "Timestamp indicating when the template was last updated."
      t: "`$STRING`"
    }
    variables: {
      h: "Variables"
      n: "variables"
      r: false
      t: "`$ARRAY`"
      union: {
        branches: 5
        count: 1
        depth: 3
      }
    }
  }

  id: {
    field: "id"
    name: "id"
  }

  name: "template"
  op: {
    create: {
      name: "create"
      points: [
        {
          co: {
            id: "POST /templates/{id}/duplicate"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "id"
                or: "id"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          m: "POST"
          o: "/templates/{id}/duplicate"
          q: {
            "$action": "duplicate"
            exist: [
              "id"
            ]
          }
          s: [
            {
              lit: "templates"
            }
            {
              var: "id"
            }
            {
              lit: "duplicate"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
        {
          co: {
            id: "POST /templates/{id}/publish"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "id"
                or: "id"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          m: "POST"
          o: "/templates/{id}/publish"
          q: {
            "$action": "publish"
            exist: [
              "id"
            ]
          }
          s: [
            {
              lit: "templates"
            }
            {
              var: "id"
            }
            {
              lit: "publish"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          co: {
            id: "GET /templates/{id}"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "id"
                or: "id"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          m: "GET"
          o: "/templates/{id}"
          q: {
            exist: [
              "id"
            ]
          }
          s: [
            {
              lit: "templates"
            }
            {
              var: "id"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
