# BasicAudienceFlow

main: kit: flow: BasicAudienceFlow:
{
  entity: "audience",
  kind: "basic",
  name: "BasicAudienceFlow",
  step: [
    {
      i: {
        ref: "audience_ref01"
      }

      o: "create"
    }

    {
      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "audience_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "audience_ref01",
        srcdatavar: "audience_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "audience01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-audience_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicAudienceFlow"
}