# BasicAutomationFlow

main: kit: flow: BasicAutomationFlow:
{
  entity: "automation",
  kind: "basic",
  name: "BasicAutomationFlow",
  step: [
    {
      i: {
        ref: "automation_ref01"
      }

      o: "create"
    }

    {
      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "automation_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "automation_ref01",
        srcdatavar: "automation_ref01_data",
        suffix: "_up0",
        textfield: "created_at"
      }

      o: "update",
      s: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-automation_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "automation_ref01",
        srcdatavar: "automation_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "automation01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-automation_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "automation_ref01",
        suffix: "_rm0"
      }

      m: {
        id: "automation01"
      }

      o: "remove"
    }

    {
      i: {
        suffix: "_rt0"
      }

      o: "list",
      v: [
        {
          apply: "ItemNotExists",
          def: {
            ref: "automation_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicAutomationFlow"
}